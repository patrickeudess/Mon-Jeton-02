rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member() { return signedIn() && request.auth.uid in resource.data.memberUids; }
    function owner() { return signedIn() && request.auth.uid == resource.data.createdByUid; }
    // Un membre ne peut jamais s'attribuer un rôle, modifier les règles de
    // crédit ou rattacher un autre projet/institution. Ces changements sont
    // réservés au créateur du groupe (ou à une future fonction serveur).
    function protectedGroupSettingsUnchanged() {
      return request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.members == resource.data.members
        && request.resource.data.inviteCode == resource.data.inviteCode
        && (resource.data.avec == null || (
          request.resource.data.avec.roles == resource.data.avec.roles
          && request.resource.data.avec.roleUids == resource.data.avec.roleUids
          && request.resource.data.avec.shareValue == resource.data.avec.shareValue
          && request.resource.data.avec.socialFundValue == resource.data.avec.socialFundValue
          && request.resource.data.avec.serviceRate == resource.data.avec.serviceRate
          && request.resource.data.avec.loanMonths == resource.data.avec.loanMonths
          && request.resource.data.avec.institution == resource.data.avec.institution
        ));
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow read: if member();
      allow update, delete: if owner()
        || (member() && protectedGroupSettingsUnchanged());
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      match /data/{documentId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /joinRequests/{requestId} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.ownerUid == get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdByUid
        && request.resource.data.inviteCode == get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode;
      allow read: if signedIn() && (request.auth.uid == resource.data.uid || request.auth.uid == resource.data.ownerUid);
      allow delete: if signedIn() && (request.auth.uid == resource.data.uid || request.auth.uid == resource.data.ownerUid);
    }

    // Le code est la clé de partage. Le document ne contient aucune donnée
    // financière ; il permet uniquement d'envoyer une demande d'adhésion.
    match /invites/{inviteCode} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
